DATABASE_URL=postgresql://bankfinances:bankfinances@db:5432/bankfinances
DATABASE_URL_LOCAL=postgresql://bankfinances:bankfinances@localhost:5432/bankfinances

SECRET_KEY=change_me_in_production

# PayPal REST API (opcional — activa el sync automático de PayPal)
# Si no se configura, PayPal también puede importarse por CSV
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# BBVA — sync automático vía Playwright
# El usuario es el NIF/NIE con el que accedes a la banca online.
BBVA_JGB_USER=
BBVA_JGB_PASSWORD=
# Si tienes una segunda cuenta BBVA (p.ej. la de tu mujer), añade sus credenciales:
# BBVA_ADI_USER=
# BBVA_ADI_PASSWORD=
